{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace_in_file|replace",
        "hooks": [
          {
            "type": "command",
            "command": ".github/scripts/sanitize-artifact-hook.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
