# ============================================================================
# Python-related artifacts and caches
# ============================================================================
__pycache__/              # Python bytecode cache directories
*.py[cod]                 # Compiled Python files (.pyc, .pyo, .pyd)
*$py.class                # Python class file variants
.pytest_cache/            # pytest test cache
.mypy_cache/              # mypy type checker cache
.ruff_cache/              # ruff linter cache
.coverage                 # test coverage report
htmlcov/                  # HTML coverage report directory
.venv/                    # Python virtual environment
venv/                     # Alternative virtual environment directory name

# ============================================================================
# IDE and OS-specific files
# ============================================================================
.DS_Store                 # macOS system file
.idea/                    # JetBrains IDE settings
.vscode/                  # Visual Studio Code settings

# ============================================================================
# Local Agent Workbench runtime state and temporary data
# ============================================================================
agent-context/            # Agent execution context and state directories
logs/                     # Application log files
status/                   # Status tracking files

# ============================================================================
# Evaluation reports and artifacts (local runs only)
# ============================================================================
eval/reports/*.json       # JSON evaluation reports
eval/reports/analyze/     # Evaluation analysis output

# ============================================================================
# Temporary and generated files
# ============================================================================
package-lock.json         # Node.js lock file (not committed; only include package.json)
/tmp_artifacts/           # Temporary build artifacts
/tmp_vault/               # Temporary vault data
/tmp_vault_direct/        # Direct temporary vault data
/workflow-fixtures/       # Workflow test fixtures
/eval/benchmarks/         # Benchmark evaluation results
/.playwright-mcp/         # Playwright MCP configuration
/.env                     # Local environment variables (secrets, API keys)
