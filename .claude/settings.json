{
  "permissions": {
    "allow": [
      "Bash(rtk *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".github/scripts/sanitize-artifact-hook.sh"
          }
        ]
      }
    ]
  }
}
